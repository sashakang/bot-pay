# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://bot_pay_user:bot_pay_password@localhost:5432/bot_pay_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Approval Token HMAC
APPROVAL_TOKEN_SECRET=your-approval-token-secret-change-in-production

# Agent Configuration
AGENT_RATE_LIMIT_REQUESTS=100
AGENT_RATE_LIMIT_WINDOW_MS=60000

# Payment Request Configuration
PAYMENT_REQUEST_APPROVAL_TIMEOUT_MINUTES=15
PAYMENT_REQUEST_EXECUTION_TIMEOUT_MINUTES=5

# Notification (Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# MCP Configuration
MCP_SERVER_PORT=3001

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
